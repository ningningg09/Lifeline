<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reaction Time Game</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #4442c2;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        h1, h2, p {
            color: white;
            text-align: center;
        }

        h1 {
            margin-top: 0;
        }

        p {
            font-size: 18px;
        }

        button {
            display: block;
            margin: 20px auto;
            padding: 10px 20px;
            font-size: 16px;
            border: 2px solid #0a0f57;
            border-radius: 5px;
            cursor: pointer;
        }

        .hidden {
            display: none !important;
        }

        #startScreen,
        #gameScreen,
        #resultsScreen {
            min-height: 100vh;
            width: 100%;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

        #startButton, #startGameButton, #playAgainButton {
            background-color: white;
            color: #0a0f57;
        }

        #playingScreen {
            min-height: 100vh;
            width: 100%;
            text-align: center;
            padding-top: 20px;
            box-sizing: border-box;
        }

        #reactionButton {
            background-color: red;
            color: white;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            font-size: 20px;
            font-weight: bold;
            border: 5px solid darkred;
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        #reactionButton:hover {
            background-color: #cc0000;
        }

        #score, #timer {
            font-size: 24px;
            font-weight: bold;
            text-align: center;
        }

        #reactionResult, #reactionRating {
            font-size: 22px;
            font-weight: bold;
            text-align: center;
        }

    </style>
</head>

<body>

    <div id="startScreen">
        <h1>Welcome to our reaction time tracker!</h1>
        <p>Track your cognitive performance for cognitive analysis</p>
        <button id="startButton">Start</button>
    </div>

    <div id="gameScreen" class="hidden">
        <h2>Click the red button as many times as you can in 30 seconds</h2>
        <button id="startGameButton">Start Game</button>
    </div>

    <div id="playingScreen" class="hidden">
        <h2>Click as fast as you can!</h2>
        <p id="timer">Time: 30</p>
        <p id="score">Clicks: 0</p>
        <button id="reactionButton">CLICK!</button>
    </div>

    <div id="resultsScreen" class="hidden">
        <h1>Time's up!</h1>
        <p id="finalScore">Your final score: 0</p>
        <p id="reactionResult"></p>
        <p id="reactionRating"></p>
        <button id="playAgainButton">Play Again</button>
    </div>

    <script>
        const startScreen = document.getElementById("startScreen");
        const gameScreen = document.getElementById("gameScreen");
        const playingScreen = document.getElementById("playingScreen");
        const resultsScreen = document.getElementById("resultsScreen");

        const startButton = document.getElementById("startButton");
        const startGameButton = document.getElementById("startGameButton");
        const reactionButton = document.getElementById("reactionButton");
        const playAgainButton = document.getElementById("playAgainButton");

        const scoreDisplay = document.getElementById("score");
        const timerDisplay = document.getElementById("timer");
        const finalScore = document.getElementById("finalScore");
        const reactionResult = document.getElementById("reactionResult");
        const reactionRating = document.getElementById("reactionRating");

        let score = 0;
        let timeLeft = 30;
        let timer;

        startButton.addEventListener("click", function() {
            startScreen.classList.add("hidden");
            gameScreen.classList.remove("hidden");
        });

        function moveButton() {
            const maxX = window.innerWidth - reactionButton.offsetWidth;
            const maxY = window.innerHeight - reactionButton.offsetHeight;

            const randomX = Math.random() * maxX;
            const randomY = Math.random() * maxY;

            reactionButton.style.left = randomX + "px";
            reactionButton.style.top = randomY + "px";
            reactionButton.style.transform = "none";
        }

        function startGame() {
            score = 0;
            timeLeft = 30;

            scoreDisplay.textContent = "Clicks: " + score;
            timerDisplay.textContent = "Time: " + timeLeft;

            gameScreen.classList.add("hidden");
            resultsScreen.classList.add("hidden");
            playingScreen.classList.remove("hidden");

            moveButton();

            timer = setInterval(function() {
                timeLeft--;

                timerDisplay.textContent = "Time: " + timeLeft;

                if (timeLeft <= 0) {
                    clearInterval(timer);

                    playingScreen.classList.add("hidden");
                    resultsScreen.classList.remove("hidden");

                    finalScore.textContent = "Your final score: " + score;

                    if (score > 0) {
                        let averageTime = 30000 / score;

                        reactionResult.textContent =
                            "Average time per click: " + averageTime.toFixed(2) + " ms";

                        if (averageTime < 250) {
                            reactionRating.textContent = "Good reaction time!";
                            reactionRating.style.color = "#90ff90";
                        } else {
                            reactionRating.textContent = "Check with a professional...";
                            reactionRating.style.color = "#ff9999";
                        }

                    } else {
                        reactionResult.textContent = "No clicks recorded.";
                        reactionRating.textContent = "Try again!";
                    }
                }

            }, 1000);
        }

        startGameButton.addEventListener("click", startGame);

        reactionButton.addEventListener("click", function() {
            if (timeLeft > 0) {
                score++;
                scoreDisplay.textContent = "Clicks: " + score;
                moveButton();
            }
        });

        playAgainButton.addEventListener("click", function() {
            resultsScreen.classList.add("hidden");
            gameScreen.classList.remove("hidden");
        });

    </script>

</body>
</html>

